# SurfAI configuration.
#
# Copy to `.env` and edit. `.env` is gitignored -- never commit real secrets.
#
#     cp .env.example .env

# --- Database ---------------------------------------------------------------
# Used by docker-compose to provision PostgreSQL. Change the password before
# exposing this stack to anything beyond your own machine.
POSTGRES_USER=surfai
POSTGRES_PASSWORD=surfai
POSTGRES_DB=surfai
POSTGRES_PORT=5432

# Read by the backend. Inside Docker the host is the `postgres` service; when
# running the backend directly on your machine, use localhost.
DATABASE_URL=postgresql+psycopg://surfai:surfai@postgres:5432/surfai

# --- LLM --------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint: Ollama, llama.cpp server,
# vLLM, LM Studio, OpenRouter, OpenAI itself.
#
# Local (Ollama on the host, backend in Docker):
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-20b

# Local (both the backend and Ollama running directly on your machine):
#   LLM_BASE_URL=http://localhost:11434/v1
#
# llama.cpp server:
#   LLM_BASE_URL=http://host.docker.internal:8080/v1
#
# A hosted OpenAI-compatible provider. The key is read by the BACKEND ONLY and
# is never sent to the Chrome extension:
#   LLM_BASE_URL=https://api.example.com/v1
#   LLM_API_KEY=sk-your-key-here
#   LLM_MODEL=gpt-oss-120b

LLM_TIMEOUT_S=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1536

# --- Agent loop -------------------------------------------------------------
# Upper bound on steps in a single task; the main guard against runaway loops.
MAX_AGENT_STEPS=15
# Consecutive failures tolerated before a task is reported as failed.
MAX_RETRIES=2
# Per-action timeout in the browser.
ACTION_TIMEOUT_MS=10000
# Whole-task timeout in seconds.
TASK_TIMEOUT_S=300

# --- Context budget ---------------------------------------------------------
# Caps on what is sent to the model. Lower is cheaper and faster; raise these
# for very dense pages.
MAX_ELEMENTS_IN_CONTEXT=60
MAX_PAGE_SUMMARY_CHARS=1200
MAX_RECENT_ACTIONS=6
MAX_EXTRACT_CHARS=4000

# --- Application ------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_PORT=8000

# Single local user for the MVP. See SECURITY.md before changing this.
AUTH_PROVIDER=local
LOCAL_USER_ID=local-user

# An unpacked extension's id differs per machine, so the wildcard is the
# practical default. It permits only the chrome-extension scheme.
CORS_ALLOW_ORIGINS=chrome-extension://*

# Categories that ALWAYS require explicit human confirmation. Removing an entry
# here weakens a core safety guarantee -- see SECURITY.md.
ALWAYS_CONFIRM_CATEGORIES=PURCHASE,PAYMENT,DELETE,ACCOUNT_CHANGES

# --- Hosted deployment only -------------------------------------------------
# `local` is a single unauthenticated user and is correct ONLY for a backend
# bound to localhost. Set `google` for anything reachable from a network.
# AUTH_PROVIDER=google
#
# The OAuth client id the extension authenticates with. Every token is checked
# against it, which is what stops a token issued to another application being
# replayed here.
# GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
#
# Optional. Empty means any Google account that authenticates with the client id
# above is accepted; set it to run a private instance.
# ALLOWED_EMAILS=you@example.com,colleague@example.com
