{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "backend/vercel_entry.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "maxLambdaSize": "50mb",
        "maxDuration": 60,
        "includeFiles": "backend/app/static/**"
      }
    },
    {
      "src": "demo/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/demo/(.*)",
      "dest": "/demo/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/vercel_entry.py"
    }
  ]
}
